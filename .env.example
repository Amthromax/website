# Amthromax Enterprise Environment Configuration Template
# Duplicate this file to .env.local for local development.
# DO NOT commit real secrets or production keys to source control.

# --- SUPABASE IDENTITY & DATA ---
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- API GATEWAY & ENDPOINTS ---
VITE_API_GATEWAY_URL=https://api.amthromax.com/v1
VITE_APP_ENV=development

# --- CLIENT SECURITY & MASKING ---
VITE_ENABLE_SECURITY_LOGGING=true
VITE_ENABLE_SEMANTIC_CACHE=true
